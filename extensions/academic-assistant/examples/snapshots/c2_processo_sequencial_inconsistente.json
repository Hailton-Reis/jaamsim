{
  "model_id": "c2_processo_sequencial_inconsistente",
  "case_id": "C2",
  "variant": "inconsistent",
  "title": "Processo produtivo sequencial - variante com inconsistencias",
  "objective": "Avaliar throughput, tempo de ciclo e gargalos em um fluxo produtivo sequencial.",
  "components": [
    {
      "id": "source_itens",
      "name": "Entrada de itens",
      "type": "source",
      "description": "Gera itens a serem processados."
    },
    {
      "id": "inspecao",
      "name": "Inspecao",
      "type": "process",
      "description": "Inspeciona o item antes do processamento principal."
    },
    {
      "id": "fila_processamento",
      "name": "Fila de processamento",
      "type": "queue",
      "description": "Buffer antes do processamento principal."
    },
    {
      "id": "processamento",
      "name": "Processamento",
      "type": "process",
      "description": "Executa a transformacao principal."
    },
    {
      "id": "saida_itens",
      "name": "Saida de itens",
      "type": "sink",
      "description": "Remove itens finalizados."
    }
  ],
  "connections": [
    {
      "from": "source_itens",
      "to": "inspecao",
      "type": "entity_flow"
    },
    {
      "from": "fila_processamento",
      "to": "processamento",
      "type": "entity_flow"
    },
    {
      "from": "processamento",
      "to": "saida_itens",
      "type": "entity_flow"
    }
  ],
  "resources": [
    {
      "id": "maquina_processamento",
      "name": "Maquina de processamento",
      "used_by": [
        "processamento"
      ]
    },
    {
      "id": "inspetor_qualidade",
      "name": "Inspetor de qualidade",
      "used_by": [
        "inspecao"
      ]
    }
  ],
  "metrics": [
    {
      "id": "tempo_ciclo",
      "name": "Tempo de ciclo",
      "target": "source_itens:saida_itens"
    }
  ],
  "assumptions": [],
  "notes": "Snapshot propositalmente com inspecao antes do processamento, fila sem entrada e sem metrica de throughput."
}
